<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "FOON" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Foon">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jura:wght@400;500;700&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="site">
    <div class="site__bg" aria-hidden="true"></div>

    <header class="site__header">
      <nav class="nav" aria-label="Primary">
        <ol class="nav__list">
          <li><span class="nav__num">0</span><%= link_to "Home",     root_path,     class: "nav__link #{'is-active' if current_page?(root_path)}" %></li>
          <li><span class="nav__num">1</span><%= link_to "About",    about_path,    class: "nav__link #{'is-active' if current_page?(about_path)}" %></li>
          <li><span class="nav__num">2</span><%= link_to "Shows",    shows_path,    class: "nav__link #{'is-active' if current_page?(shows_path)}" %></li>
          <li><span class="nav__num">3</span><%= link_to "Releases", releases_path, class: "nav__link #{'is-active' if current_page?(releases_path)}" %></li>
          <li><span class="nav__num">4</span><%= link_to "Video",    video_path,    class: "nav__link #{'is-active' if current_page?(video_path)}" %></li>
        </ol>
      </nav>

      <%= link_to "FOON", root_path, class: "brand" %>

      <div class="page-title" aria-hidden="true"><%= content_for(:page_title) %></div>
    </header>

    <main class="site__main">
      <%= yield %>
    </main>

    <footer class="site__footer">
      <a class="footer__email" href="mailto:foon.sound@gmail.com">foon.sound@gmail.com</a>

      <ul class="footer__socials">
        <li><a href="https://instagram.com" target="_blank" rel="noopener">Instagram</a></li>
        <li><a href="https://youtube.com"   target="_blank" rel="noopener">Youtube</a></li>
        <li><a href="https://linktr.ee"     target="_blank" rel="noopener">Linktree</a></li>
      </ul>

      <p class="footer__copy">© 2026 <a href="https://github.com/" target="_blank" rel="noopener">Andrius Dereviancenko</a></p>
    </footer>
  </body>
</html>
