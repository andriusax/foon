<% content_for :title, "Shows — FOON" %>
<% content_for :page_title, "Shows" %>

<%
  upcoming = [
    { day: "30", month: "May", venue: "Venue", place: "Place", url: "#" },
    { day: "12", month: "Jun", venue: "Venue", place: "Place", url: "#" }
  ]
  past = [
    { day: "10", month: "Mar", venue: "Venue", place: "Place", url: "#" },
    { day: "02", month: "Feb", venue: "Venue", place: "Place", url: "#" }
  ]
%>

<section class="shows">
  <div class="shows__section">
    <h2 class="shows__heading">Upcoming</h2>
    <% upcoming.each do |s| %>
      <article class="show">
        <div class="show__date">
          <span class="show__day"><%= s[:day] %></span>
          <span class="show__month"><%= s[:month] %></span>
        </div>
        <div class="show__venue"><%= s[:venue].upcase %></div>
        <div class="show__place"><%= s[:place].upcase %></div>
        <%= link_to "Tickets", s[:url], class: "show__action" %>
      </article>
    <% end %>
  </div>

  <div class="shows__section">
    <h2 class="shows__heading shows__heading--past">Past</h2>
    <% past.each do |s| %>
      <article class="show show--past">
        <div class="show__date">
          <span class="show__day"><%= s[:day] %></span>
          <span class="show__month"><%= s[:month] %></span>
        </div>
        <div class="show__venue"><%= s[:venue].upcase %></div>
        <div class="show__place"><%= s[:place].upcase %></div>
        <span class="show__action show__action--disabled">Tickets</span>
      </article>
    <% end %>
  </div>
</section>
