<% content_for :title, "Video — FOON" %>
<% content_for :page_title, "Video" %>

<%
  videos = [
    { id: "VP1am9q0Ijo", start: nil },
    { id: "96kHzBH6jaQ", start: 230 }
  ]
%>

<section class="videos">
  <% videos.each do |video| %>
    <div class="video-embed">
      <iframe
        src="https://www.youtube-nocookie.com/embed/<%= video[:id] %><%= "?start=#{video[:start]}" if video[:start] %>"
        title="YouTube video"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen></iframe>
    </div>
  <% end %>
</section>
